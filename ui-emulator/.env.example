# Copier en `.env` (ignoré par git) et adapter. Une variable déjà définie dans l'environnement reste prioritaire.

# Profil du projet à émuler : profiles/<nom>.json
RBX_PROFILE=dont-fish

# (facultatif) remplace le champ "project" du profil
# RBX_PROJECT=C:/chemin/vers/le/projet

# Outil de capture (tools/cdp.mjs)
# EMU_URL=http://127.0.0.1:5175
# EDGE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# EMU_DPR=1
