# Copier en `.env` (ignore par git). `npm start` le charge s'il existe.

# Port et adresse d'ecoute
PORT=3000
HOST=127.0.0.1

# Adresse publique du site (controle d'origine des formulaires, drapeau Secure des cookies)
# Derriere HTTPS : https://host.exemple.fr
PUBLIC_URL=http://localhost:3000

# Dossier de la base SQLite et de la cle de chiffrement (cree automatiquement)
DATA_DIR=./data

# Cle de 32 octets en base64 qui chiffre les secrets A2F en base. Generee dans DATA_DIR/secret.key si absente.
# HOST_SECRET_KEY=

# Inscriptions : par defaut seul le PREMIER compte peut etre cree. true = ouvertes a tous.
# ALLOW_SIGNUP=false

# Nom affiche dans l'application d'authentification
APP_NAME=Roblox Project Manager

# Connexion des comptes Roblox : se configure dans la page « Reglages » du site (administrateur), pas ici.
# Ces variables ne servent que de solution de secours (la base de donnees a priorite) :
# ROBLOX_CLIENT_ID=
# ROBLOX_CLIENT_SECRET=
# ROBLOX_OAUTH_SCOPES=openid profile group:read universe-places:write
